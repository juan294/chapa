{
  "name": "chapa",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @chapa/web dev",
    "build": "pnpm --filter @chapa/web build",
    "start": "pnpm --filter @chapa/web start",
    "lint": "pnpm --filter @chapa/web lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @chapa/web test:e2e",
    "check:circular": "pnpm dlx madge --circular --extensions ts,tsx --ts-config tsconfig.madge.json apps/web/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.4",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "minimatch": ">=10.2.3",
      "dompurify": ">=3.4.0",
      "ajv": ">=6.14.0 <7.0.0",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "undici": ">=7.24.0 <8.0.0",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.5",
      "protobufjs": ">=7.5.5",
      "vite": ">=8.0.8"
    }
  }
}
