{
  "name": "chapa",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @chapa/web dev",
    "build": "pnpm --filter @chapa/web build",
    "start": "pnpm --filter @chapa/web start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @chapa/web test:e2e",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "delete-user": "tsx scripts/delete-user.ts",
    "check:circular": "pnpm dlx madge --circular --extensions ts,tsx --ts-config tsconfig.madge.json apps/web/ packages/shared/src/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "minimatch": ">=10.2.3",
      "dompurify": ">=3.4.11",
      "ajv": ">=6.14.0 <7.0.0",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "undici": ">=7.28.0 <8.0.0",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.6",
      "protobufjs": ">=7.5.5",
      "vite": ">=8.0.8",
      "typescript-eslint": ">=8.58.0",
      "@typescript-eslint/eslint-plugin": ">=8.58.0",
      "@typescript-eslint/parser": ">=8.58.0",
      "@typescript-eslint/utils": ">=8.58.0",
      "@typescript-eslint/typescript-estree": ">=8.58.0",
      "@typescript-eslint/type-utils": ">=8.58.0",
      "@typescript-eslint/scope-manager": ">=8.58.0",
      "@typescript-eslint/visitor-keys": ">=8.58.0",
      "@typescript-eslint/project-service": ">=8.58.0",
      "@typescript-eslint/tsconfig-utils": ">=8.58.0",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.10",
      "js-yaml": ">=4.2.0"
    }
  }
}
