{
  "name": "chapa",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "pnpm --filter @chapa/web dev",
    "build": "pnpm --filter @chapa/web build",
    "start": "pnpm --filter @chapa/web start",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:contract": "vitest run -c vitest.config.contract.ts",
    "test:contract:local": "tsx scripts/test-contract-local.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @chapa/web test:e2e",
    "validate:migrations": "tsx scripts/validate-migrations.ts",
    "check:write-registration": "tsx scripts/check-write-registration.ts --max-unregistered=0",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:vulnerabilities": "tsx scripts/check-vulnerabilities.ts",
    "check:pending-migrations": "tsx scripts/check-pending-migrations.ts",
    "check:vercel-config": "tsx scripts/check-vercel-config.ts",
    "quality:validate": "tsx scripts/quality/validate-release-required.ts",
    "release:prepare-run": "tsx scripts/quality/prepare-release-run.ts",
    "release:analyze": "tsx scripts/quality/analyze-release-run.ts",
    "release:render-report": "tsx scripts/quality/render-release-report.ts",
    "release:collect-evidence": "tsx scripts/quality/collect-playwright-evidence.ts",
    "release:verify-identity": "tsx scripts/quality/verify-deployment-identity.ts",
    "release:merge-evidence": "tsx scripts/quality/merge-release-evidence.ts",
    "release:validate-docs": "tsx scripts/quality/validate-release-docs.ts",
    "test:release-required": "pnpm --filter @chapa/web exec playwright test e2e/release-required.spec.ts --project=chromium",
    "delete-user": "tsx scripts/delete-user.ts",
    "heal-poisoned-stats": "tsx scripts/heal-poisoned-stats.ts",
    "check:circular": "pnpm dlx madge --circular --extensions ts,tsx --ts-config tsconfig.madge.json apps/web/ packages/shared/src/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "6.27.0",
    "tsx": "^4.23.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "minimatch": ">=10.2.3",
      "dompurify": ">=3.4.12 <4.0.0",
      "ajv": ">=6.14.0 <7.0.0",
      "rollup": ">=4.59.0",
      "flatted": ">=3.4.2",
      "undici": ">=7.28.0 <8.0.0",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.8 <6.0.0",
      "protobufjs": ">=7.5.5",
      "vite": ">=8.1.4",
      "typescript-eslint": ">=8.58.0",
      "@typescript-eslint/eslint-plugin": ">=8.58.0",
      "@typescript-eslint/parser": ">=8.58.0",
      "@typescript-eslint/utils": ">=8.58.0",
      "@typescript-eslint/typescript-estree": ">=8.58.0",
      "@typescript-eslint/type-utils": ">=8.58.0",
      "@typescript-eslint/scope-manager": ">=8.58.0",
      "@typescript-eslint/visitor-keys": ">=8.58.0",
      "@typescript-eslint/project-service": ">=8.58.0",
      "@typescript-eslint/tsconfig-utils": ">=8.58.0",
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18 <9.0.0",
      "js-yaml": ">=4.3.0 <5.0.0",
      "sharp": "0.35.3"
    }
  }
}
