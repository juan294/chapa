{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["**/*.test.{ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["du"],
  "ignore": ["vitest.setup.ts", "test/stubs/server-only.ts"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "@chapa/shared",
        "@upstash/redis",
        "@supabase/supabase-js"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/route.ts",
        "app/**/error.tsx",
        "app/**/loading.tsx",
        "app/**/not-found.tsx",
        "scripts/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "postcss",
        "server-only",
        "tsx",
        "@resvg/resvg-js",
        "@vercel/analytics",
        "@vercel/speed-insights",
        "canvas-confetti",
        "next-themes",
        "posthog-js",
        "resend",
        "svix"
      ]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
