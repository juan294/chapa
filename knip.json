{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": [
    "du",
    "supabase",
    "osv-scanner"
  ],
  "ignore": [
    "test/stubs/server-only.ts",
    "apps/web/test/contract/**",
    ".design-sync/previews/**",
    ".design-sync/emit-tokens.mjs",
    "apps/web/.ds-entry.tsx"
  ],
  "ignoreFiles": [
    "docs/design/chapa-redesign-reference/badge-lab/proposal-theme.ts",
    "docs/design/chapa-redesign-reference/badge-lab/ProposalSvg.ts",
    "docs/design/chapa-redesign-reference/script.js",
    "docs/design/chapa-redesign-reference/shell.js",
    "docs/design/chapa-redesign-reference/theme.js",
    "docs/research/2026-09-05-scoring-audit-probes.ts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "next"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/route.ts",
        "app/**/error.tsx",
        "app/**/loading.tsx",
        "app/**/not-found.tsx",
        "e2e/helpers/vercel-protection-global-setup.ts",
        "scripts/**/*.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tsx"
      ]
    },
    "packages/shared": {
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
