{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["du"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "@chapa/shared",
        "@upstash/redis",
        "@supabase/supabase-js"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/route.ts",
        "app/**/error.tsx",
        "app/**/loading.tsx",
        "app/**/not-found.tsx"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "tailwindcss",
        "postcss"
      ]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
