{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["scripts/**"],
  "workspaces": {
    "apps/web": {
      "ignoreDependencies": [
        "eslint-plugin-import",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-react-hooks",
        "postcss",
        "postcss-load-config"
      ],
      "ignore": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/route.ts",
        "app/**/error.tsx",
        "app/**/loading.tsx",
        "app/**/not-found.tsx",
        "app/global-error.tsx"
      ],
      "ignoreBinaries": ["vitest"]
    }
  }
}
