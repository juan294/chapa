{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["du", "supabase", "osv-scanner"],
  "ignore": [
    "test/stubs/server-only.ts",
    "apps/web/test/contract/**"
  ],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "ignoreDependencies": [
        "next",
        "@upstash/redis",
        "@supabase/supabase-js"
      ]
    },
    "apps/web": {
      "entry": [
        "app/**/page.tsx",
        "app/**/layout.tsx",
        "app/**/route.ts",
        "app/**/error.tsx",
        "app/**/loading.tsx",
        "app/**/not-found.tsx",
        "scripts/**/*.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/shared": {
      "project": ["src/**/*.ts"]
    }
  }
}
