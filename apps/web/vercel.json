{
  "git": {
    "deploymentEnabled": {
      "develop": false,
      "hotfix/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/warm-cache",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-audience",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/process-campaigns",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/latency-check",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/collect-evidence",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "app/api/cron/warm-cache/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync-audience/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/process-campaigns/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/latency-check/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/collect-evidence/route.ts": {
      "maxDuration": 300
    }
  }
}
