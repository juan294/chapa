{
  "ignoreCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then exit 1; fi; if [ -z \"$VERCEL_GIT_COMMIT_REF\" ]; then exit 1; fi; case \"$VERCEL_GIT_COMMIT_REF\" in release/*) exit 1 ;; develop) if [ -n \"$VERCEL_GIT_PULL_REQUEST_ID\" ]; then exit 1; fi ;; esac; exit 0",
  "crons": [
    {
      "path": "/api/cron/warm-cache",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sync-audience",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/process-campaigns",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/latency-check",
      "schedule": "15 6 * * *"
    }
  ],
  "functions": {
    "app/api/cron/warm-cache/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/sync-audience/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/process-campaigns/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/latency-check/route.ts": {
      "maxDuration": 60
    }
  }
}
