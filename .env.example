# GitHub OAuth — two separate OAuth Apps recommended (github.com/settings/developers)
# Production app ("Chapa"): callback https://chapa.thecreativetoken.com/api/auth/callback
# Dev app ("Chapa Dev"):     callback http://localhost:3001/api/auth/callback
# Use the dev app credentials here; production credentials go in Vercel env vars.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase (optional — database features degrade gracefully without it)
SUPABASE_URL=              # Supabase project URL (server-side only)
SUPABASE_SERVICE_ROLE_KEY= # Service role key (server-side only, never NEXT_PUBLIC_)

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Resend (optional — email notifications)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SUPPORT_FORWARD_EMAIL=

# GitHub personal access token (optional — used as fallback when no OAuth token available)
GITHUB_TOKEN=

# Badge verification
CHAPA_VERIFICATION_SECRET=   # HMAC secret for badge verification hash (required for /api/verify)

# Feature flags
NEXT_PUBLIC_STUDIO_ENABLED=     # Set to "true" to enable Creator Studio (optional, disabled by default)
NEXT_PUBLIC_EXPERIMENTS_ENABLED=   # Set to "true" to enable /experiments pages (optional)
NEXT_PUBLIC_INSIGHTS_ENABLED=     # Set to "true" to enable AI Insights integration (optional, disabled by default)
NEXT_PUBLIC_BITBUCKET_ENABLED=  # Set to "true" to enable Bitbucket linking (optional, disabled by default)
NEXT_PUBLIC_CODEBERG_ENABLED=   # Set to "true" to enable Codeberg linking (optional, disabled by default)
NEXT_PUBLIC_GITLAB_ENABLED=     # Set to "true" to enable GitLab linking (optional, disabled by default)

# Bitbucket OAuth (optional — required when NEXT_PUBLIC_BITBUCKET_ENABLED=true)
BITBUCKET_CLIENT_ID=            # Bitbucket OAuth consumer key
BITBUCKET_CLIENT_SECRET=        # Bitbucket OAuth consumer secret

# Codeberg OAuth (optional — required when NEXT_PUBLIC_CODEBERG_ENABLED=true)
CODEBERG_CLIENT_ID=             # Codeberg OAuth app client ID
CODEBERG_CLIENT_SECRET=         # Codeberg OAuth app secret

# GitLab OAuth (optional — required when NEXT_PUBLIC_GITLAB_ENABLED=true)
GITLAB_CLIENT_ID=               # GitLab OAuth app client ID
GITLAB_CLIENT_SECRET=           # GitLab OAuth app secret

# Admin
ADMIN_HANDLES=                     # Comma-separated GitHub handles allowed to access /admin (optional)
ADMIN_SECRET=                      # Bearer token for /api/admin/stats endpoint (optional)
ALLOW_AGENT_RUN=                   # Set to "true" to allow /api/admin/agents/run endpoint (optional, disabled by default)

# Vercel Cron (auto-injected by Vercel on Pro plan — set locally for testing)
CRON_SECRET=
# Comma-separated GitHub handles always refreshed first by the warm-cache cron (optional)
WARM_CACHE_PRIORITY_HANDLES=

# Vercel environment (auto-injected by Vercel — do not set locally)
# VERCEL_ENV=

# Bundle analyzer (dev-only)
# ANALYZE=true                     # Set to "true" to enable @next/bundle-analyzer in next.config.ts
