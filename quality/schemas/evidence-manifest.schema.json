{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapa.dev/schemas/evidence-manifest.schema.json",
  "title": "Chapa comprehensive release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "stage",
    "candidate",
    "results",
    "exploratoryCharters",
    "manualObligations",
    "exceptions",
    "rollbackReference",
    "tagAuthorization"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
    "stage": { "enum": ["pre-merge", "final"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["developCommit", "candidateTreeDigest", "previewUrl"],
      "properties": {
        "developCommit": { "$ref": "#/$defs/digest" },
        "candidateTreeDigest": { "$ref": "#/$defs/digest" },
        "previewUrl": { "$ref": "#/$defs/httpUrl" },
        "previewIdentity": { "$ref": "#/$defs/digest" },
        "mainCommit": { "$ref": "#/$defs/digest" },
        "mainTreeDigest": { "$ref": "#/$defs/digest" },
        "productionUrl": { "$ref": "#/$defs/httpUrl" },
        "productionIdentity": { "$ref": "#/$defs/digest" }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "evidence-fragment.schema.json#/$defs/result"
      }
    },
    "exploratoryCharters": {
      "type": "array",
      "items": { "$ref": "exploratory-charter.schema.json" }
    },
    "manualObligations": {
      "type": "array",
      "items": {
        "$ref": "release-run.schema.json#/$defs/manualObligation"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "release-run.schema.json#/$defs/exception"
      }
    },
    "rollbackReference": { "type": "string", "minLength": 1 },
    "tagAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "authorized"] },
        "authorizedBy": { "type": "string", "minLength": 1 },
        "authorizedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "authorized" } } },
          "then": { "required": ["authorizedBy", "authorizedAt"] }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["authorizedBy"] },
                { "required": ["authorizedAt"] }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    }
  }
}
