{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapa.dev/schemas/release-required.schema.json",
  "title": "Chapa release-required catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "runner",
        "selector",
        "environments",
        "safetyClass",
        "required",
        "expectedOracles",
        "evidenceRetentionDays"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" },
        "owner": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["local-contract", "ci-build", "preview", "production"]
          }
        },
        "safetyClass": {
          "enum": [
            "read-only",
            "synthetic-local-write",
            "authorized-preview-interaction",
            "production-operation",
            "outward-effect"
          ]
        },
        "required": { "type": "boolean" },
        "expectedOracles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ui",
              "http",
              "datastore",
              "vendor",
              "telemetry",
              "cleanup",
              "deployment-identity",
              "configuration"
            ]
          }
        },
        "evidenceRetentionDays": { "type": "integer", "minimum": 1 },
        "manualObligationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "id": { "const": "release.manual-arcs" } }
          },
          "then": { "required": ["manualObligationIds"] }
        }
      ]
    }
  }
}
