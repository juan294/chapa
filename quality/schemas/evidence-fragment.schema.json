{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapa.dev/schemas/evidence-fragment.schema.json",
  "title": "Chapa normalized evidence fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "environment", "candidateIdentity", "results"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "environment": { "enum": ["local-contract", "ci-build", "preview", "production"] },
    "candidateIdentity": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cleanupStatus", "residueEvidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "cleanupStatus": { "enum": ["removed", "present", "unknown"] },
        "residueEvidence": { "type": "string" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "environment", "status", "startedAt", "finishedAt", "runner", "evidence", "fixtures"],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "environment": { "enum": ["local-contract", "ci-build", "preview", "production"] },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "runner": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "fixtures": {
          "type": "array",
          "items": { "$ref": "#/$defs/fixture" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
