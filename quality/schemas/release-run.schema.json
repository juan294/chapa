{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chapa.dev/schemas/release-run.schema.json",
  "title": "Chapa release evidence run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "baselineTag",
    "candidate",
    "obligations",
    "results",
    "exceptions",
    "manualObligations",
    "exploratoryCharters",
    "rollbackReference",
    "tagAuthorization"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "baselineTag": {
      "type": "string",
      "pattern": "^(v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?|[0-9a-f]{40})$"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["developCommit", "candidateTreeDigest", "previewUrl"],
      "properties": {
        "developCommit": { "$ref": "#/$defs/digest" },
        "candidateTreeDigest": { "$ref": "#/$defs/digest" },
        "previewUrl": { "$ref": "#/$defs/httpUrl" },
        "previewIdentity": { "$ref": "#/$defs/digest" },
        "mainCommit": { "$ref": "#/$defs/digest" },
        "mainTreeDigest": { "$ref": "#/$defs/digest" },
        "productionUrl": { "$ref": "#/$defs/httpUrl" },
        "productionIdentity": { "$ref": "#/$defs/digest" }
      }
    },
    "obligations": {
      "type": "array",
      "items": { "$ref": "#/$defs/obligation" }
    },
    "results": {
      "type": "array",
      "items": { "$ref": "evidence-fragment.schema.json#/$defs/result" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    },
    "manualObligations": {
      "type": "array",
      "items": { "$ref": "#/$defs/manualObligation" }
    },
    "exploratoryCharters": {
      "type": "array",
      "items": { "$ref": "exploratory-charter.schema.json" }
    },
    "rollbackReference": { "type": "string", "minLength": 1 },
    "tagAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "authorized"] },
        "authorizedBy": { "type": "string", "minLength": 1 },
        "authorizedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "authorized" } } },
          "then": { "required": ["authorizedBy", "authorizedAt"] }
        },
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["authorizedBy"] },
                { "required": ["authorizedAt"] }
              ]
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "environment": {
      "enum": ["local-contract", "ci-build", "preview", "production"]
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "required", "environment", "status"],
      "properties": {
        "scenarioId": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "environment": { "$ref": "#/$defs/environment" },
        "status": { "enum": ["pending", "passed", "failed", "skipped"] }
      }
    },
    "manualObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "executor", "executedAt", "environment", "candidate", "result", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "executor": { "type": "string", "minLength": 1 },
        "executedAt": { "type": "string", "format": "date-time" },
        "environment": { "$ref": "#/$defs/environment" },
        "candidate": { "$ref": "#/$defs/digest" },
        "result": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "skipped"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenarioId", "reason", "risk", "approvedBy", "createdAt", "expiresAt", "followUp"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scenarioId": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high"] },
        "approvedBy": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "followUp": { "type": "string", "minLength": 1 }
      }
    }
  }
}
