{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(pnpm run *)",
      "Bash(pnpm install *)",
      "Bash(pnpm install)",
      "Bash(pnpm add *)",
      "Bash(pnpm outdated *)",
      "Bash(pnpm audit *)",
      "Bash(pnpm dlx *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx knip *)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "case \"$CLAUDE_TOOL_INPUT\" in *'git commit'*) npx tsc --noEmit && pnpm test -- --bail ;; esac"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
